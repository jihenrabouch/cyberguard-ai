# ==============================================================================
# Configuration des Variables d'Environnement — Projet Federateur AI-BD_BI
# Copier ce fichier en '.env' et adapter avec vos secrets reels
# NE JAMAIS COMMITER LE FICHIER '.env' DANS GIT !
# ==============================================================================

# --- Environnement General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# --- Base Vectorielle Qdrant ---
QDRANT_HOST=localhost
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=rag_enterprise_docs
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine

# --- Base de Donnees PostgreSQL ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=supersecretdevpassword
POSTGRES_DB=federateur_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://appuser:supersecretdevpassword@localhost:5432/federateur_dev

# --- Modeles IA & Embeddings ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-large
LLM_PROVIDER=openai # openai | mistral | ollama | vllm
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Tracing MLOps (Optionnel S3/S4) ---
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

